{
  "expo": {
    "name": "NestMate",
    "slug": "nestmate",
    "version": "2.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2026.07.1"
    },
    "android": {
      "package": "com.nestmate.app",
      "versionCode": 200,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NestMate uses your photos to build your profile and help prospective roommates identify you.",
          "cameraPermission": "NestMate uses your camera to capture profile photos directly in the app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c8da1c79-4a2a-4bd0-b87b-3e96b553fe36"
      }
    },
    "owner": "greatestgrace"
  }
}
